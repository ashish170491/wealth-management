### Secrets ###
# Real credentials live in config/application.yml, which Spring Boot loads at a higher
# precedence than the packaged classpath:/application.yml. The tracked file has only
# ${VAR:} placeholders. config/application.yml.example is the tracked template.
config/*
!config/application.yml.example
application-local.yml
application-secrets.yml
.env
.env.*
!.env.example
*.bak
*.pem
*.key
*.p12
*.jks
*.pfx
id_rsa*

### Personal financial data -- never publish ###
# Zerodha tradebook exports: real trades, ISINs, order ids, account number in the filename.
# The app ingests these through POST /api/portfolio/tax-lots/import-zerodha-csv, not from the repo.
tradebook-*.csv
holdings-*.csv
*-tradebook*.csv

